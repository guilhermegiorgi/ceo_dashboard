{
  "name": "gg-ai-labs-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "PORT=3000 next dev",
    "dev:backend": "nodemon server/index.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "server": "node server/index.js",
    "test": "vitest run",
    "test:backend": "vitest run",
    "test:backend:watch": "vitest",
    "test:backend:ui": "vitest --ui",
    "test:backend:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:obc": "node server/scripts/e2e-obc-flow.js",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "test:coverage": "playwright test --reporter=json tests/e2e --output=tests/e2e/.reports/coverage",
    "format": "prettier --write .",
    "setup": "node server/scripts/setup.js",
    "migrate": "node server/scripts/migrate.js",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "db:setup": "node server/scripts/db-setup.js",
    "test:stack": "node server/scripts/test-stack.js",
    "vault:setup": "node server/scripts/vault-setup.js setup",
    "vault:sync": "node server/scripts/vault-setup.js sync",
    "vault:status": "node server/scripts/vault-setup.js status",
    "test:user": "node server/scripts/create-test-user.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.52",
    "@assistant-ui/react": "^0.11.30",
    "@assistant-ui/react-ai-sdk": "^1.1.6",
    "@hapi/joi": "^17.1.1",
    "@types/react-router-dom": "^5.3.3",
    "ai": "^5.0.76",
    "assistant-ui": "^0.0.61",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cron": "^2.3.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "http-status-codes": "^2.2.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.546.0",
    "morgan": "^1.10.0",
    "next": "^15.5.6",
    "node-cron": "^3.0.2",
    "node-fetch": "^3.3.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.3",
    "pino": "^8.14.1",
    "pino-pretty": "^10.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.5.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.3",
    "recharts": "^3.3.0",
    "redis": "^4.6.10",
    "remark-gfm": "^4.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.8.2",
    "ws": "^8.14.2",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.18",
    "c8": "^10.1.3",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "globals": "^15.9.0",
    "jest-environment-jsdom": "^30.2.0",
    "node-pg-migrate": "^8.0.3",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.35",
    "prettier": "^2.8.4",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "undici": "^7.16.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "dashboard",
    "ceo",
    "obsidian",
    "ai",
    "cognito",
    "insights"
  ],
  "author": "GG.AI Team",
  "license": "MIT"
}
