# Configurações do Servidor
NODE_ENV=development
PORT=3001

# Segurança
JWT_SECRET=seu_segredo_jwt_aqui
JWT_EXPIRES_IN=7d
COOKIE_SECRET=seu_segredo_para_cookies

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (Cache)
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# Obsidian Brain Cloud (REST + MCP)
BRAINCLOUD_BASE_URL=http://localhost:8000
BRAINCLOUD_API_TOKEN=seu_token_api_ou_jwt
BRAINCLOUD_TENANT_ID=
BRAINCLOUD_TENANT_PLAN=
# Endpoints MCP (usar WebSocket ou HTTP streamable)
BRAINCLOUD_MCP_WS=ws://localhost:8000/mcp
BRAINCLOUD_MCP_HTTP=http://localhost:8000/api/v1/mcp/http
# Feature flags
ENABLE_BRAINCLOUD_REST=true
ENABLE_BRAINCLOUD_MCP=true

# Cognito API (Serviço de IA)
COGNITO_API_URL=http://localhost:8000
COGNITO_API_KEY=sua_chave_api_cognito

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Configurações de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutos
RATE_LIMIT_MAX=100

# Configurações de Upload
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# Configurações de E-mail (opcional)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=seu_usuario
SMTP_PASS=sua_senha
SMTP_FROM=nao-responda@exemplo.com
