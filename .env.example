# CEO Dashboard – Environment Configuration

# ===================================
# Backend Configuration
# ===================================

# Server
NODE_ENV=development
PORT=3001

# Database (PostgreSQL) - Supabase Configuration
# Option 1: Using DATABASE_URL (recommended)
DATABASE_URL=postgresql://postgres.dhhfcvpfijyuneikzrtd:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# Option 2: Using individual variables
DB_HOST=aws-1-sa-east-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.dhhfcvpfijyuneikzrtd
DB_PASSWORD=[YOUR-PASSWORD]
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Session (for OAuth)
SESSION_SECRET=change-this-session-secret-to-random-string

# Encryption (for sensitive data like MCP API keys)
ENCRYPTION_KEY=change-this-to-a-32-character-key

# OAuth Authentication (Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# ===================================
# Frontend Configuration
# ===================================

# API Gateway (Node/Express) do próprio dashboard
VITE_API_BASE_URL=http://localhost:3001

# Conexão com Obsidian Brain Cloud (Nuvem - GG.AI Labs)
VITE_BRAINCLOUD_BASE_URL=https://obsidian-mcp.ggailabs.com
VITE_BRAINCLOUD_API_TOKEN=ggai_90e2c6b20c8315906f843798bbc1598df596978a2ec79457e6d00563c76d03dc

# Conexão com Obsidian Brain Cloud (via MCP)
VITE_BRAINCLOUD_MCP_HTTP=https://obsidian-mcp.ggailabs.com/api/v1/mcp/http/
VITE_ENABLE_MCP_FEATURES=true

# WebSocket interno do dashboard (eventos/stream)
VITE_WEBSOCKET_URL=ws://localhost:3001

# Serviços externos opcionais
VITE_OPENAI_API_KEY=
VITE_EMBEDDINGS_API_URL=
VITE_EMBEDDINGS_API_KEY=

# Observabilidade (opcional)
VITE_SENTRY_DSN=
VITE_LOG_LEVEL=info
