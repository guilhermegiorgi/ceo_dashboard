# CEO Dashboard – Frontend .env.example

# API Gateway (Node/Express) do próprio dashboard
VITE_API_BASE_URL=http://localhost:3001

# Conexão com Obsidian Brain Cloud (via REST)
VITE_BRAINCLOUD_BASE_URL=http://localhost:8000
VITE_BRAINCLOUD_API_TOKEN=troque_por_token_real
VITE_BRAINCLOUD_TENANT_ID=
VITE_BRAINCLOUD_TENANT_PLAN=

# Conexão com Obsidian Brain Cloud (via MCP)
VITE_BRAINCLOUD_MCP_WS=ws://localhost:8000/mcp
VITE_BRAINCLOUD_MCP_HTTP=http://localhost:8000/api/v1/mcp/http
VITE_ENABLE_MCP_FEATURES=true

# WebSocket interno do dashboard (eventos/stream)
VITE_WEBSOCKET_URL=ws://localhost:3001

# Serviços externos opcionais
VITE_OPENAI_API_KEY=
VITE_EMBEDDINGS_API_URL=
VITE_EMBEDDINGS_API_KEY=

# Observabilidade (opcional)
VITE_SENTRY_DSN=
VITE_LOG_LEVEL=info
